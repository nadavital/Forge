# Optional — dashboard works without this using local persisted data in .forge-data/
#
# When your partner's Supabase backend is ready, copy this file to .env.local:
#   cp .env.local.example .env.local
#
# Then fill in values from the hosted Supabase project.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional local-only migration helper input. Do not deploy this to the browser/runtime.
SUPABASE_DB_URL=
# Optional. Set to local to force .forge-data JSON storage even when Supabase credentials are present.
FORGE_STORAGE_BACKEND=
# Optional. Set to 1 to keep project status updates on polling even when Supabase is configured.
FORGE_DISABLE_SUPABASE_REALTIME=0

# Server-side only. Never expose the service role key to the browser.
FORGE_USER_ID=local-user
FORGE_WORKSPACE_ID=local-workspace
FORGE_AUTH_SUBJECT=
# Optional cookie name when your hosted shell stores a raw Supabase access token
# outside the standard sb-*-auth-token cookies.
FORGE_AUTH_BEARER_COOKIE=
# Optional absolute app URL used in Supabase magic-link redirects.
FORGE_PUBLIC_APP_URL=http://localhost:3000
# Set to 1 in hosted deployments to redirect unauthenticated dashboard users to /login.
FORGE_REQUIRE_AUTH=0
# Optional escape hatch for trusted background jobs when FORGE_REQUIRE_AUTH=1.
FORGE_ALLOW_SERVER_IDENTITY_WHEN_AUTH_REQUIRED=0
FORGE_USER_EMAIL=
FORGE_USER_NAME=
FORGE_WORKSPACE_NAME=
FORGE_TOKEN_ENCRYPTION_KEY=

# Optional AI idea-intake compiler.
FORGE_IDEA_COMPILER_AGENT=gemini-2.5-pro
FORGE_IDEA_COMPILER_TIMEOUT_MS=120000
FORGE_MANAGED_RESEARCH_URL=
FORGE_MANAGED_RESEARCH_SECRET=
FORGE_ALLOW_UNAUTHENTICATED_MANAGED_RESEARCH=0
FORGE_MANAGED_RESEARCH_TIMEOUT_MS=120000
FORGE_RESEARCH_LIMIT_PER_SOURCE=10
FORGE_RESEARCH_MAX_OPPORTUNITIES=4
# Required for POST /api/pipeline/worker. CRON_SECRET is also accepted.
FORGE_PIPELINE_WORKER_SECRET=

# Optional managed build adapter. Leave FORGE_BUILDER_ADAPTER unset for auto mode:
# Gemini is used when GEMINI_API_KEY is present; otherwise local simulation is used.
FORGE_BUILDER_ADAPTER=
GEMINI_API_KEY=
FORGE_GEMINI_BUILDER_AGENT=antigravity-preview-05-2026
FORGE_TEMPLATE_REPO_URL=https://github.com/forge-labs/mvp-template
FORGE_GENERATED_REPO_OWNER=

# Optional local-dev fallback. Ignored unless FORGE_ALLOW_GITHUB_TOKEN_FALLBACK=1 and FORGE_REQUIRE_AUTH is off.
# Prefer GitHub App installation tokens and GitHub user OAuth for real project flows.
GITHUB_TOKEN=
FORGE_ALLOW_GITHUB_TOKEN_FALLBACK=0
# Optional local-dev UI/action for manually saving a GitHub App installation id.
# Keep disabled for hosted/product use; prefer the GitHub App install callback.
FORGE_ENABLE_GITHUB_DEV_FALLBACK=0

# Preferred GitHub App path for user-scoped repo access.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_STATE_SECRET=
GITHUB_STATE_MAX_AGE_SECONDS=900
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
