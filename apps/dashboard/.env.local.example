# Optional — dashboard works without this using local persisted data in .forge-data/
#
# When your partner's Supabase backend is ready, copy this file to .env.local:
#   cp .env.local.example .env.local
#
# Then fill in values from the hosted Supabase project.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only. Never expose the service role key to the browser.

# Optional managed build adapter. Leave FORGE_BUILDER_ADAPTER unset for auto mode:
# Gemini is used when GEMINI_API_KEY is present; otherwise local simulation is used.
FORGE_BUILDER_ADAPTER=
GEMINI_API_KEY=
FORGE_GEMINI_BUILDER_AGENT=antigravity-preview-05-2026
FORGE_TEMPLATE_REPO_URL=https://github.com/forge-labs/mvp-template

# Optional. Increases GitHub API quota and allows private repos the token can read.
GITHUB_TOKEN=
